# Sands-sorter environment configuration.
# Copy to .env for local dev. In production, prefer Google Secret Manager.

# --- Core ---
ENV=local                       # local | prod
SECRET_KEY=change-me            # session signing key
TIMEZONE=Australia/Sydney
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+psycopg://sands:sands@localhost:5432/sands

# --- App auth (Google OAuth login) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8000/auth/callback
ALLOWED_EMAILS=you@example.com  # comma-separated allowlist (max ~3)

# --- Source: Dropbox ---
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_INBOX_PATH=/Inbox
DROPBOX_PROCESSED_PATH=/processed

# --- Google Drive (target) ---
DRIVE_ROOT_FOLDER_ID=           # parent folder under which "Properties/" lives
DRIVE_OAUTH_TOKEN_JSON=         # path to user token.json (local dev)

# --- Google Cloud (prod) ---
GCP_PROJECT_ID=
DOCUMENT_AI_PROCESSOR_ID=
DOCUMENT_AI_LOCATION=us         # or eu, au, etc.
SECRET_MANAGER_PREFIX=sands

# --- Anthropic (LLM fallback) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Summary ---
SUMMARY_CADENCE=weekly          # weekly | daily
SUMMARY_HOUR=7                  # local hour
SUMMARY_RECIPIENTS=you@example.com
CONFIDENCE_THRESHOLD=0.7        # below -> Unsorted
OCR_TEXT_RETENTION_DAYS=90
